# Local Postgres (e.g. Postgres.app).
DATABASE_URL="postgresql://USER@localhost:5432/realm"
# Tests use a separate database, migrated automatically before the DB tests run.
TEST_DATABASE_URL="postgresql://USER@localhost:5432/realm_test"

# In production (Vercel + Neon), DATABASE_URL is Neon's *pooled* address and
# migrations need the direct one. The Neon Marketplace integration sets
# DATABASE_URL_UNPOOLED, which prisma.config.ts reads; DIRECT_URL overrides it.
# DIRECT_URL="postgresql://..."
